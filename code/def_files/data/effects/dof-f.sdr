// Far-only depth of field: one full-resolution gather on the HDR scene colour, before bloom
// and tonemapping. Pixels in front of blurStart stay sharp; the blur then grows linearly over
// blurRamp metres to maxBlur. There is no near-field blur. OpenGL only.
#ifdef GL_ES
precision highp float;
precision highp sampler2D;
#endif

layout(location = 0) out vec4 fragOut0;

in vec4 fragTexCoord;

uniform sampler2D tex;       // HDR scene colour
uniform sampler2D depth_tex; // scene depth, [0,1] perspective depth
uniform sampler2D cockpit_depth_tex; // the cockpit has its own depth buffer; 1 where there is no cockpit

layout(std140) uniform genericData {
	float blurStart; // view z (metres) where the blur starts
	float blurRamp;  // metres from blurStart to maxBlur
	float maxBlur;   // circle of confusion (CoC) clamp in pixels
	float skyBlur;   // scale of the CoC of pixels with no depth (stars, background)

	float zNear;
	float zFar;
	float pad0;
	float pad1;
};

const int SAMPLES = 96;
const float GOLDEN_ANGLE = 2.39996323;

float linear_z(float d)
{
	return 2.0 * zNear * zFar / (zFar + zNear - (2.0 * d - 1.0) * (zFar - zNear));
}

float coc_of(vec2 suv)
{
	// The scene depth under the cockpit is the space behind it, so the cockpit must be tested first.
	if (texture(cockpit_depth_tex, suv).x < 1.0) {
		return 0.0;
	}
	float d = texture(depth_tex, suv).x;
	float c = clamp((linear_z(d) - blurStart) / blurRamp, 0.0, 1.0) * maxBlur;
	return d >= 1.0 ? c * skyBlur : c;
}

// Colour and depth must come from the same texel. Bilinear colour next to nearest depth
// lets a sharp ship's edge colour into the sky blur as a dark outline.
vec2 snap_uv(vec2 suv, vec2 texel)
{
	return (floor(suv / texel) + 0.5) * texel;
}

void main()
{
	vec2 uv = fragTexCoord.xy;
	vec2 texel = 1.0 / vec2(textureSize(depth_tex, 0));
	vec3 centre = texture(tex, uv).rgb;
	float c0 = coc_of(uv);

	if (c0 < 0.5) {
		fragOut0 = vec4(centre, 1.0);
		return;
	}

	// Golden-angle disc scaled to this pixel's own CoC. A sharp sample never joins the blur, so a
	// sharp ship keeps a clean edge against a blurred background.
	vec3 sum = centre;
	float wsum = 1.0;
	for (int i = 0; i < SAMPLES; i++) {
		float r = c0 * sqrt((float(i) + 0.5) / float(SAMPLES));
		float a = float(i) * GOLDEN_ANGLE;
		vec2 o = vec2(cos(a), sin(a)) * r;
		vec2 suv = snap_uv(uv + o * texel, texel);
		float cs = coc_of(suv);
		if (cs <= 0.0) {
			continue;
		}
		float w = clamp(cs - r + 1.0, 0.0, 1.0);
		sum += texture(tex, suv).rgb * w;
		wsum += w;
	}
	fragOut0 = vec4(sum / wsum, 1.0);
}
