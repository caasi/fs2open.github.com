// SSAO spike (throwaway). Ground-truth ambient occlusion (GTAO, Jimenez et al. 2016,
// structure follows XeGTAO) computed from the existing deferred position and normal
// buffers at half resolution, plus a depth-aware separable blur (BLUR_H / BLUR_V).
#ifdef GL_ES
precision highp float;
precision highp int;
precision highp sampler2D;
#endif

#include "z-compress.sdr" //! #include "z-compress.sdr"

layout(location = 0) out vec4 fragOut0;

in vec4 fragTexCoord;

uniform sampler2D PositionBuffer; // full res: view-space xy, compressed -z, baked ao
uniform sampler2D NormalBuffer;   // full res: view-space normal, gloss
uniform sampler2D AOInput;        // half res: raw AO (blur passes only)

layout(std140) uniform genericData {
	mat4 projMatrix;

	float radius;         // world-space (view-space) sampling radius
	float power;          // final contrast
	float maxPixelRadius; // clamp of the screen-space radius, in full-res pixels
	float debugMode;      // spike: 2 = encode why a pixel exits early
};

const float PI = 3.14159265;
const float HALF_PI = 1.57079633;
const int SLICE_COUNT = 3;
const int STEPS_PER_SIDE = 6;
// The G-buffer is full resolution, this pass runs at half resolution.
const int DOWNSCALE = 2;

vec3 fetch_pos(ivec2 fullResTexel)
{
	vec4 p = texelFetch(PositionBuffer, fullResTexel, 0);
	return vec3(p.xy, uncompress_depth_value(p.z));
}

#if defined(BLUR_H) || defined(BLUR_V)

void main()
{
	ivec2 c = ivec2(gl_FragCoord.xy);
	ivec2 aoSize = textureSize(AOInput, 0);
	float centerZ = fetch_pos(c * DOWNSCALE).z;
	// Tolerance scales with distance, so a far hull is still one surface.
	float tolerance = 0.02 * abs(centerZ) + 0.05;

	float sum = 0.0;
	float wsum = 0.0;
	for (int i = -3; i <= 3; i++) {
#ifdef BLUR_H
		ivec2 t = c + ivec2(i, 0);
#else
		ivec2 t = c + ivec2(0, i);
#endif
		t = clamp(t, ivec2(0), aoSize - 1);
		float z = fetch_pos(t * DOWNSCALE).z;
		float w = exp(-abs(z - centerZ) / tolerance);
		sum += texelFetch(AOInput, t, 0).r * w;
		wsum += w;
	}
	fragOut0 = vec4(sum / wsum);
}

#else

// Interleaved gradient noise (Jimenez 2014)
float ign(vec2 p)
{
	return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

void main()
{
	ivec2 c = ivec2(gl_FragCoord.xy);
	ivec2 full = c * DOWNSCALE;
	ivec2 fullSize = textureSize(PositionBuffer, 0);

	vec3 P = fetch_pos(full);
	// deferred-clear writes -1000000 (compressed) for empty pixels; anything that far is sky.
	if (-P.z >= 0.5 * GLOBAL_FAR_Z) {
		fragOut0 = vec4(1.0);
		return;
	}

	vec3 N = normalize(texelFetch(NormalBuffer, full, 0).xyz);
	vec3 V = normalize(-P);

	// world radius -> full-res pixels: projMatrix[1][1] = 1/tan(fovy/2)
	float pixRadius = radius * projMatrix[1][1] * 0.5 * float(fullSize.y) / -P.z;
	pixRadius = min(pixRadius, maxPixelRadius);
	if (pixRadius < 1.5) {
		// debugMode 2: 0.5 = too far for the radius (AO skipped)
		fragOut0 = vec4(debugMode == 2.0 ? 0.5 : 1.0);
		return;
	}

	float noiseSlice = ign(vec2(c));
	float noiseStep = ign(vec2(c) + vec2(37.0, 17.0));

	// falloff over the outer 60% of the radius
	float falloffRange = 0.6 * radius;
	float falloffMul = -1.0 / falloffRange;
	float falloffAdd = (radius - falloffRange) / falloffRange + 1.0;

	float visibility = 0.0;
	for (int s = 0; s < SLICE_COUNT; s++) {
		float phi = (float(s) + noiseSlice) / float(SLICE_COUNT) * PI;
		vec2 omega = vec2(cos(phi), sin(phi));

		vec3 dir3 = vec3(omega, 0.0);
		vec3 ortho = dir3 - dot(dir3, V) * V;
		vec3 axis = normalize(cross(ortho, V));
		vec3 projN = N - axis * dot(N, axis);
		float projNLen = length(projN);
		float signN = sign(dot(ortho, projN));
		float cosN = clamp(dot(projN, V) / max(projNLen, 1e-5), 0.0, 1.0);
		float n = signN * acos(cosN);

		float lowHorizonCos0 = cos(n + HALF_PI);
		float lowHorizonCos1 = cos(n - HALF_PI);
		float horizonCos0 = lowHorizonCos0;
		float horizonCos1 = lowHorizonCos1;

		for (int st = 0; st < STEPS_PER_SIDE; st++) {
			float sf = (float(st) + noiseStep) / float(STEPS_PER_SIDE);
			sf = sf * sf; // more samples near the center
			sf += 1.5 / pixRadius; // never sample the center texel
			ivec2 off = ivec2(round(omega * sf * pixRadius));

			vec3 S0 = fetch_pos(clamp(full + off, ivec2(0), fullSize - 1));
			vec3 S1 = fetch_pos(clamp(full - off, ivec2(0), fullSize - 1));

			vec3 d0 = S0 - P;
			vec3 d1 = S1 - P;
			float dist0 = length(d0);
			float dist1 = length(d1);
			float w0 = clamp(dist0 * falloffMul + falloffAdd, 0.0, 1.0);
			float w1 = clamp(dist1 * falloffMul + falloffAdd, 0.0, 1.0);
			float shc0 = mix(lowHorizonCos0, dot(d0 / dist0, V), w0);
			float shc1 = mix(lowHorizonCos1, dot(d1 / dist1, V), w1);
			horizonCos0 = max(horizonCos0, shc0);
			horizonCos1 = max(horizonCos1, shc1);
		}

		float h0 = -acos(clamp(horizonCos1, -1.0, 1.0));
		float h1 = acos(clamp(horizonCos0, -1.0, 1.0));
		h0 = n + clamp(h0 - n, -HALF_PI, HALF_PI);
		h1 = n + clamp(h1 - n, -HALF_PI, HALF_PI);

		float iarc0 = (cosN + 2.0 * h0 * sin(n) - cos(2.0 * h0 - n)) * 0.25;
		float iarc1 = (cosN + 2.0 * h1 * sin(n) - cos(2.0 * h1 - n)) * 0.25;
		visibility += projNLen * (iarc0 + iarc1);
	}
	visibility = clamp(visibility / float(SLICE_COUNT), 0.0, 1.0);
	// debugMode 2: AO computed, mapped into 0..0.4 so it is apart from the skip code
	fragOut0 = vec4(debugMode == 2.0 ? 0.4 * pow(visibility, power) : pow(visibility, power));
}

#endif
